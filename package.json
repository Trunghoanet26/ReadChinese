{
  "name": "readchinese",
  "productName": "ReadChinese",
  "version": "1.4.0",
  "description": "Screen OCR for Chinese with pinyin above every character, Google + multi-provider AI translation and read-aloud",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "debug": "electron . --enable-logging",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.readchinese",
    "productName": "ReadChinese",
    "files": [
      "src/**",
      "assets/**",
      "native/**"
    ],
    "extraResources": [
      {
        "from": "python",
        "to": "python",
        "filter": [
          "*.py",
          "requirements.txt"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": "portable"
    },
    "portable": {
      "artifactName": "ReadChinese-${version}-portable.exe"
    },
    "asarUnpack": [
      "**/*.node"
    ]
  },
  "optionalDependencies": {
    "node-screenshots": "0.2.8"
  }
}